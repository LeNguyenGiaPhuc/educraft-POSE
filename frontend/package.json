{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "cd .. && oxlint frontend/src tests/frontend",
    "test": "npm run test:unit && npm run test:node",
    "test:unit": "vitest run --exclude \"**/*.test.mjs\"",
    "test:node": "node --test ../tests/frontend/src/features/admin/classrooms/studentImport.test.mjs ../tests/frontend/src/features/teacher/activities/activitiesPermission.test.mjs ../tests/frontend/src/features/teacher/schedule/calendarDate.test.mjs ../tests/frontend/test/design-foundation.test.mjs ../tests/frontend/test/vite-config.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "read-excel-file": "^9.3.14",
    "tailwindcss": "^4.3.5",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
